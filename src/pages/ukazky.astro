---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferenceCard from '../components/ReferenceCard.astro';
import CTABanner from '../components/CTABanner.astro';
import { references } from '../data/content';
import { getUrl } from '../lib/utils';

const selectedType = Astro.url.searchParams.get('typ') || 'vse';
const filteredReferences = selectedType === 'vse' 
  ? references 
  : references.filter(ref => ref.type === selectedType);
---

<BaseLayout 
  title="Ukázky webových stránek pro školy | Školní weby"
  description="Prohlédněte si ukázky webových stránek pro školy z celé ČR. Reálné školní weby MŠ, ZŠ i SŠ navržené s důrazem na přehlednost a použitelnost."
>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://skolniweby.cz/ukazky#webpage",
        "url": "https://skolniweby.cz/ukazky",
        "name": "Ukázky školních webů",
        "inLanguage": "cs-CZ",
        "description": "Ukázky webových stránek pro mateřské, základní a střední školy z celé České republiky. Reálné školní weby vytvořené a spravované projektem Školní weby.",
        "isPartOf": {
          "@id": "https://skolniweby.cz/#website"
        },
        "about": {
          "@id": "https://skolniweby.cz/#organization"
        }
      },
      {
        "@type": "ItemList",
        "@id": "https://skolniweby.cz/ukazky#portfolio",
        "name": "Ukázky webových stránek pro školy",
        "itemListOrder": "https://schema.org/ItemListUnordered",
        "numberOfItems": 3,
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "item": {
              "@type": "EducationalOrganization",
              "name": "Střední průmyslová škola technická",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Jablonec nad Nisou",
                "addressCountry": "CZ"
              },
              "url": "https://skolniweby.cz/ukazky"
            }
          },
          {
            "@type": "ListItem",
            "position": 2,
            "item": {
              "@type": "EducationalOrganization",
              "name": "Gymnázium U Balvanu",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Jablonec nad Nisou",
                "addressCountry": "CZ"
              },
              "url": "https://skolniweby.cz/ukazky"
            }
          },
          {
            "@type": "ListItem",
            "position": 3,
            "item": {
              "@type": "EducationalOrganization",
              "name": "ZŠ Šumava",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Jablonec nad Nisou",
                "addressCountry": "CZ"
              },
              "url": "https://skolniweby.cz/ukazky"
            }
          }
        ]
      }
    ]
  })} />

  <section class="pt-24 md:pt-32 pb-16 md:pb-24 bg-gradient-to-br from-primary-50 via-white to-primary-50">
    <div class="container-custom">
      <div class="mb-12 scroll-reveal">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Ukázky školních webů</h1>
        <p class="text-lg text-gray-600 max-w-5xl">
          Podívejte se na konkrétní ukázky webů mateřských, základních, středních i uměleckých škol, které jsme navrhli a dlouhodobě spravujeme. Každý web vznikl podle potřeb konkrétní školy, jejího vedení, rodičů i zřizovatele.
        </p>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap justify-center gap-3 mb-12 scroll-reveal hidden">
        <a 
          href={getUrl('/ukazky?typ=vse')}
          class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
            selectedType === 'vse' 
              ? 'bg-accent text-white' 
              : 'bg-white text-gray-700 hover:bg-gray-100'
          }`}
        >
          Vše
        </a>
        <a 
          href={getUrl('/ukazky?typ=ms')}
          class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
            selectedType === 'ms' 
              ? 'bg-accent text-white' 
              : 'bg-white text-gray-700 hover:bg-gray-100'
          }`}
        >
          MŠ
        </a>
        <a 
          href={getUrl('/ukazky?typ=zs')}
          class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
            selectedType === 'zs' 
              ? 'bg-accent text-white' 
              : 'bg-white text-gray-700 hover:bg-gray-100'
          }`}
        >
          ZŠ
        </a>
        <a 
          href={getUrl('/ukazky?typ=ss')}
          class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
            selectedType === 'ss' 
              ? 'bg-accent text-white' 
              : 'bg-white text-gray-700 hover:bg-gray-100'
          }`}
        >
          SŠ
        </a>
        <a 
          href={getUrl('/ukazky?typ=zus')}
          class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
            selectedType === 'zus' 
              ? 'bg-accent text-white' 
              : 'bg-white text-gray-700 hover:bg-gray-100'
          }`}
        >
          ZUŠ
        </a>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {filteredReferences.map((ref) => (
          <ReferenceCard {...ref} />
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <CTABanner 
    title="Vyřešte web školy jednou provždy"
    ctaText="Konzultace zdarma"
    ctaHref="/kontakt"
  />
</BaseLayout>

