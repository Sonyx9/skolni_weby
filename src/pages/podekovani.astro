---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUrl } from '../lib/utils';
---

<BaseLayout
  title="Děkujeme za odeslání formuláře | ŠkolníWeby"
  description="Vaše zpráva byla úspěšně odeslána. Ozveme se vám co nejdříve a nezávazně s vámi probereme potřeby vaší školy."
>
  <!-- Hero Section -->
  <section class="relative pt-24 md:pt-32 pb-16 md:pb-24 overflow-hidden bg-gradient-to-br from-brand-50 via-white to-brand-50">
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <!-- Success Icon -->
        <div class="mb-8 flex justify-center">
          <div class="w-20 h-20 bg-accent rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6">
          Děkujeme za odeslání formuláře
        </h1>
        
        <p class="text-xl md:text-2xl text-gray-700 mb-4 leading-relaxed">
          Vaše zpráva byla úspěšně odeslána.
        </p>
        
        <p class="text-lg md:text-xl text-gray-600 mb-8 leading-relaxed max-w-2xl mx-auto">
          Ozveme se vám co nejdříve a nezávazně s vámi probereme potřeby vaší školy.
        </p>
        
        <div class="bg-white/80 backdrop-blur-sm rounded-xl p-6 md:p-8 shadow-sm border border-gray-100 max-w-2xl mx-auto">
          <p class="text-gray-700 text-base md:text-lg leading-relaxed">
            Nemusíte se na nic připravovat – vše vysvětlíme srozumitelně a bez technických složitostí.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Next Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-12 text-center">
          Co bude následovat?
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
          <!-- Step 1 -->
          <div class="text-center scroll-reveal">
            <div class="w-16 h-16 bg-accent rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              Ozveme se telefonicky nebo e-mailem
            </h3>
            <p class="text-gray-600">
              Kontaktujeme vás do 24 hodin od odeslání formuláře
            </p>
          </div>
          
          <!-- Step 2 -->
          <div class="text-center scroll-reveal">
            <div class="w-16 h-16 bg-accent rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              Probereme vaši situaci a očekávání
            </h3>
            <p class="text-gray-600">
              Zjistíme, co od webu očekáváte a jaké máte potřeby
            </p>
          </div>
          
          <!-- Step 3 -->
          <div class="text-center scroll-reveal">
            <div class="w-16 h-16 bg-accent rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              Doporučíme nejvhodnější řešení webu pro vaši školu
            </h3>
            <p class="text-gray-600">
              Navrhneme balíček, který nejlépe vyhovuje vašim potřebám
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Meanwhile Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-gray-50 to-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8 text-center">
          Mezitím se můžete podívat
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Ukázky -->
          <a 
            href={getUrl('/ukazky')} 
            class="group bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-accent hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2"
          >
            <div class="w-12 h-12 bg-brand-50 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent transition-colors">
              <svg class="w-6 h-6 text-brand group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-accent transition-colors">
              Ukázky školních webů
            </h3>
            <p class="text-gray-600 text-sm">
              Podívejte se na weby, které jsme vytvořili pro školy
            </p>
            <div class="mt-4 text-accent font-medium text-sm group-hover:underline">
              Zobrazit ukázky →
            </div>
          </a>
          
          <!-- Jak to probíhá -->
          <a 
            href={getUrl('/jak-to-probiha')} 
            class="group bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-accent hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2"
          >
            <div class="w-12 h-12 bg-brand-50 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent transition-colors">
              <svg class="w-6 h-6 text-brand group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-accent transition-colors">
              Jak probíhá spolupráce
            </h3>
            <p class="text-gray-600 text-sm">
              Zjistěte, jaký je proces od prvního kontaktu po spuštění
            </p>
            <div class="mt-4 text-accent font-medium text-sm group-hover:underline">
              Zjistit více →
            </div>
          </a>
          
          <!-- Ceník -->
          <a 
            href={getUrl('/cenik')} 
            class="group bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-accent hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2"
          >
            <div class="w-12 h-12 bg-brand-50 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent transition-colors">
              <svg class="w-6 h-6 text-brand group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-accent transition-colors">
              Ceník a balíčky
            </h3>
            <p class="text-gray-600 text-sm">
              Prohlédněte si naše balíčky a transparentní ceník
            </p>
            <div class="mt-4 text-accent font-medium text-sm group-hover:underline">
              Zobrazit ceník →
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Scroll reveal animation
  if (typeof window !== 'undefined') {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.scroll-reveal').forEach(el => {
      observer.observe(el);
    });
  }
</script>

<style>
  .scroll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .scroll-reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>
