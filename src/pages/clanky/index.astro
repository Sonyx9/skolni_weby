---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { getUrl } from '../../lib/utils';
---

<BaseLayout title="Články o webových stránkách pro školy | Školní weby" description="Praktické články o tvorbě, správě a legislativě webových stránek pro školy. Rady, postupy a tipy pro MŠ, ZŠ i SŠ.">
  <Hero 
    title="Články"
    subtitle="Tipy, návody a novinky ze světa školních webů."
  />
  
  <section class="section bg-white">
    <div class="container-custom">

      <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-12 text-center">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        <h2 class="text-2xl font-semibold text-gray-900 mb-2">Tuto sekci pro vás připravujeme</h2>
        <p class="text-gray-600">Brzy zde najdete užitečné články, tipy a návody pro správu školních webů.</p>
      </div>
    </div>
  </section>
</BaseLayout>
