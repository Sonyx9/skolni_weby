---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
---

<BaseLayout 
  title="Kontakt - Nezávazná nabídka | ŠkolníWeby"
  description="Kontaktujte nás pro nezávaznou nabídku webu pro vaši školu. Rádi vám odpovíme na všechny otázky a připravíme cenovou kalkulaci."
>
  <Hero 
    title="Kontakt"
    subtitle="Máte dotaz nebo chcete nezávaznou nabídku? Napište nám nebo zavolejte."
  />

  <section class="section bg-white">
    <div class="container-custom max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <Card class="scroll-reveal">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Kontaktní údaje</h3>
          <div class="space-y-4">
            <div>
              <div class="text-sm text-gray-500 mb-1">Email</div>
              <a href="mailto:info@broken-mouse.cz" class="text-brand hover:text-primary-800 font-medium">
                info@broken-mouse.cz
              </a>
            </div>
            <div>
              <div class="text-sm text-gray-500 mb-1">Telefon</div>
              <a href="tel:+420776831780" class="text-brand hover:text-primary-800 font-medium">
                +420 776 831 780
              </a>
            </div>
            <div>
              <div class="text-sm text-gray-500 mb-1">Provozní doba</div>
              <div class="text-gray-700">Pondělí - Pátek: 9:00 - 17:00</div>
            </div>
          </div>
        </Card>

        <Card class="scroll-reveal">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Rychlý kontakt</h3>
          <div class="space-y-4">
            <a 
              href="mailto:info@broken-mouse.cz?subject=Nezávazná nabídka"
              class="block w-full px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-brand transition-colors text-center"
            >
              Poslat email
            </a>
            <a 
              href="tel:+420776831780"
              class="block w-full px-6 py-3 bg-white text-brand font-semibold rounded-lg border-2 border-brand hover:bg-primary-50 transition-colors text-center"
            >
              Zavolat
            </a>
          </div>
        </Card>
      </div>

      <!-- Fakturační údaje -->
      <Card class="scroll-reveal">
        <h3 class="text-xl font-semibold text-gray-900 mb-4">Fakturační údaje</h3>
        <div class="space-y-2 text-gray-700">
          <div><strong>Název:</strong> [DOPLNIT]</div>
          <div><strong>IČO:</strong> [DOPLNIT]</div>
          <div><strong>DIČ:</strong> [DOPLNIT — pokud máte]</div>
          <div><strong>Adresa sídla:</strong> [DOPLNIT]</div>
          <div class="text-sm text-gray-500">Vložte zde fakturační údaje, které se mají objevit na smlouvách a fakturách.</div>
        </div>
      </Card>

      <!-- Kontaktní formulář -->
      <Card class="scroll-reveal">
        <h3 class="text-xl font-semibold text-gray-900 mb-4">Kontaktní formulář</h3>
        <form id="contactForm" action="/api/contact" method="POST" class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              Jméno a příjmení <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition"
              placeholder="Ing. Jan Novák"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email <span class="text-red-500">*</span>
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition"
              placeholder="jan.novak@skola.cz"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
              Telefon <span class="text-red-500">*</span>
            </label>
            <input 
              type="tel" 
              id="phone" 
              name="phone"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition"
              placeholder="+420 123 456 789"
            />
          </div>

          <div>
            <label for="school" class="block text-sm font-medium text-gray-700 mb-2">
              Název školy
            </label>
            <input 
              type="text" 
              id="school" 
              name="school"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition"
              placeholder="Základní škola Jablonec nad Nisou"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
              Vaše zpráva
            </label>
            <textarea 
              id="message" 
              name="message"
              rows="5"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition resize-y"
              placeholder="Napište nám, co potřebujete..."
            ></textarea>
          </div>

          <div id="formError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
          </div>

          <div id="formSuccess" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">
            ✓ Zpráva byla úspěšně odeslána. Děkujeme!
          </div>

          <button 
            type="submit"
            class="w-full px-6 py-4 bg-accent text-white font-semibold rounded-lg hover:bg-brand transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span class="submit-text">Odeslat zprávu</span>
            <span class="submit-loader hidden">Odesílám...</span>
          </button>

          <p class="text-sm text-gray-500 text-center">
            * Povinné pole
          </p>
        </form>
      </Card>
    </div>
  </section>
</BaseLayout>

<script>
  // Scroll reveal
  if (typeof window !== 'undefined') {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.scroll-reveal').forEach(el => {
      observer.observe(el);
    });
  }

  // Contact form handling
  const form = document.getElementById('contactForm');
  const formError = document.getElementById('formError');
  const formSuccess = document.getElementById('formSuccess');
  
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]');
      const submitText = submitBtn.querySelector('.submit-text');
      const submitLoader = submitBtn.querySelector('.submit-loader');
      
      // Hide messages
      formError.classList.add('hidden');
      formSuccess.classList.add('hidden');
      
      // Show loading state
      submitBtn.disabled = true;
      submitText.classList.add('hidden');
      submitLoader.classList.remove('hidden');
      
      try {
        const formData = new FormData(form);
        
        // Log for debugging
        console.log('Odeslání formuláře na:', form.action);
        console.log('Data:', {
          name: formData.get('name'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          school: formData.get('school'),
          message: formData.get('message')
        });
        
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData
        });
        
        console.log('Odpověď status:', response.status);
        const responseData = await response.json().catch(() => ({}));
        console.log('Odpověď data:', responseData);
        
        if (response.ok) {
          // Success
          console.log('Formulář úspěšně odeslán');
          formSuccess.classList.remove('hidden');
          form.reset();
          
          // Redirect after 2 seconds
          setTimeout(() => {
            window.location.href = '/podekovani';
          }, 2000);
        } else {
          throw new Error(responseData.message || 'Chyba při odesílání: ' + response.status);
        }
      } catch (error) {
        console.error('Chyba formuláře:', error);
        // Error
        formError.textContent = '❌ ' + error.message;
        formError.classList.remove('hidden');
        
        // Reset button state
        submitBtn.disabled = false;
        submitText.classList.remove('hidden');
        submitLoader.classList.add('hidden');
      }
    });
  }
</script>

