---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
---

<BaseLayout
  title="Kontakt | Webové stránky pro školy – Školní weby"
  description="Kontaktujte nás pro nezávaznou nabídku webových stránek pro školy. Rádi poradíme a doporučíme vhodné řešení pro vaši školu."
>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ContactPage",
        "@id": "https://skolniweby.cz/kontakt/#contactpage",
        "url": "https://skolniweby.cz/kontakt/",
        "name": "Kontakt",
        "inLanguage": "cs-CZ",
        "description": "Kontakt na Školní weby (Broken Mouse s.r.o.). Nezávazná poptávka webových stránek pro školy a dotazy k nabídce.",
        "isPartOf": {
          "@id": "https://skolniweby.cz/#website"
        },
        "about": {
          "@id": "https://skolniweby.cz/#organization"
        },
        "mainEntity": {
          "@id": "https://skolniweby.cz/#organization"
        }
      },
      {
        "@type": "Organization",
        "@id": "https://skolniweby.cz/#organization",
        "name": "Školní weby",
        "legalName": "Broken Mouse s.r.o.",
        "url": "https://skolniweby.cz/",
        "email": "info@broken-mouse.cz",
        "telephone": "+420776831780",
        "logo": {
          "@type": "ImageObject",
          "@id": "https://skolniweby.cz/#logo",
          "url": "https://lukaskoula.com/wp-content/uploads/2025/12/skolni-weby-logo-modra-webp.webp"
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Jeronýmova 98/27",
          "addressLocality": "Jablonecké Paseky",
          "postalCode": "466 02",
          "addressCountry": "CZ"
        },
        "taxID": "CZ08731811",
        "vatID": "CZ08731811",
        "identifier": [
          {
            "@type": "PropertyValue",
            "name": "IČO",
            "value": "08731811"
          },
          {
            "@type": "PropertyValue",
            "name": "DIČ",
            "value": "CZ08731811"
          }
        ],
        "areaServed": {
          "@type": "Country",
          "name": "Czech Republic"
        },
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "contactType": "sales",
            "telephone": "+420776831780",
            "email": "info@broken-mouse.cz",
            "availableLanguage": ["cs"],
            "url": "https://skolniweby.cz/kontakt/"
          },
          {
            "@type": "ContactPoint",
            "contactType": "customer support",
            "telephone": "+420776831780",
            "email": "info@broken-mouse.cz",
            "availableLanguage": ["cs"],
            "url": "https://skolniweby.cz/kontakt/"
          }
        ]
      }
    ]
  })} />

  <Hero 
    title="Kontakt"
    subtitle="Máte dotaz k webovým stránkám pro vaši školu nebo chcete nezávaznou nabídku? Ozvěte se nám – rádi s vámi probereme vaši situaci a doporučíme vhodné řešení."
    subtitleWide={true}
  />

  <section class="section bg-white">
    <div class="container-custom max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <Card class="scroll-reveal md:order-1 order-2">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Kontaktní údaje</h3>
          <div class="space-y-4">
            <div>
              <div class="text-sm text-gray-500 mb-1">Kontaktní osoba</div>
              <div class="text-gray-900 font-medium">Ing. Ondřej Činátl</div>
            </div>
            <div>
              <div class="text-sm text-gray-500 mb-1">Email</div>
              <a href="mailto:info@broken-mouse.cz" class="text-brand hover:text-primary-800 font-medium">
                info@broken-mouse.cz
              </a>
            </div>
            <div>
              <div class="text-sm text-gray-500 mb-1">Telefon</div>
              <a href="tel:+420776831780" class="text-brand hover:text-primary-800 font-medium">
                +420 776 831 780
              </a>
            </div>
            <div>
              <div class="text-sm text-gray-500 mb-1">Provozní doba</div>
              <div class="text-gray-700">Pondělí - Pátek: 9:00 - 15:00</div>
            </div>
          </div>
        </Card>

        <Card class="scroll-reveal md:order-2 order-1">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Rychlý kontakt</h3>
          <div class="space-y-4">
            <a 
              href="#contactForm"
              class="block w-full px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-brand transition-colors text-center"
            >
              Vyplnit formulář
            </a>
            <a 
              href="mailto:info@broken-mouse.cz?subject=Nezávazná nabídka"
              class="block w-full px-6 py-3 bg-white text-brand font-semibold rounded-lg border-2 border-brand hover:bg-primary-50 transition-colors text-center"
            >
              Poslat email
            </a>
            <a 
              href="tel:+420776831780"
              class="block w-full px-6 py-3 bg-white text-brand font-semibold rounded-lg border-2 border-brand hover:bg-primary-50 transition-colors text-center"
            >
              Zavolat
            </a>
          </div>
        </Card>
      </div>

      <!-- Kontaktní formulář -->
      <div id="contactForm" style="scroll-margin-top: 100px;">
        <Card class="scroll-reveal">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Kontaktní formulář</h3>
          <form id="contactFormElement" action="https://skolniwebyformular-production.up.railway.app/api/contact" method="POST" class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              Jméno a příjmení <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition"
              placeholder="Ing. Jan Novák"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email <span class="text-red-500">*</span>
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition"
              placeholder="jan.novak@skola.cz"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
              Telefon <span class="text-red-500">*</span>
            </label>
            <input 
              type="tel" 
              id="phone" 
              name="phone"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition"
              placeholder="+420 123 456 789"
            />
          </div>

          <div>
            <label for="school" class="block text-sm font-medium text-gray-700 mb-2">
              Název školy
            </label>
            <input 
              type="text" 
              id="school" 
              name="school"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition"
              placeholder="Základní škola Jablonec nad Nisou"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
              Vaše zpráva <span class="text-red-500">*</span>
            </label>
            <textarea 
              id="message" 
              name="message"
              rows="5"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand focus:border-transparent outline-none transition resize-y"
              placeholder="Napište nám, co potřebujete..."
            ></textarea>
          </div>

          <div id="formError" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
          </div>

          <div id="formSuccess" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">
            ✓ Zpráva byla úspěšně odeslána. Děkujeme!
          </div>

          <button 
            type="submit"
            class="w-full px-6 py-4 bg-accent text-white font-semibold rounded-lg hover:bg-brand transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span class="submit-text">Odeslat zprávu</span>
            <span class="submit-loader hidden">Odesílám...</span>
          </button>

          <p class="text-sm text-gray-500 text-center">
            * Povinné pole
          </p>
        </form>
        </Card>
      </div>

      <div class="grid grid-cols-1 gap-8 mt-8">
        <!-- Fakturační údaje -->
        <Card class="scroll-reveal">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Fakturační údaje</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2 text-gray-700 text-sm">
              <div><strong>Broken Mouse s.r.o.</strong></div>
              <div>IČO: 08731811</div>
              <div>DIČ: CZ08731811</div>
            </div>
            <div class="space-y-2 text-gray-700 text-sm">
              <div class="font-semibold text-gray-900 mb-1">Bankovní spojení</div>
              <div>Číslo účtu: 2201731044/2010</div>
              <div>Banka: Fio banka</div>
            </div>
            <div class="space-y-2 text-gray-700 text-sm">
              <div class="font-semibold text-gray-900 mb-1">Sídlo společnosti</div>
              <div>Jeronýmova 98/27</div>
              <div>466 02, Jablonecké Paseky</div>
              <div>Česká republika</div>
            </div>
            <div class="space-y-2 text-gray-700 text-sm">
              <div class="font-semibold text-gray-900 mb-1">Korespondenční adresa</div>
              <div>Mlýnská 350/24</div>
              <div>466 01, Jablonec nad Nisou</div>
            </div>
          </div>
        </Card>

        <!-- Naše kanceláře -->
        <Card class="scroll-reveal">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Naše kanceláře</h3>
          <div class="space-y-2 text-gray-700">
            <div>
              <div class="font-semibold text-gray-900 mb-1">Adresa</div>
              <div>Mlýnská 350/24</div>
              <div>466 01, Jablonec nad Nisou</div>
            </div>
            <div class="pt-2">
              <div class="font-semibold text-gray-900 mb-1">Otevírací doba</div>
              <div>Dle domluvy</div>
            </div>
            <div class="pt-4">
              <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2525.683925098791!2d15.1731856907178!3d50.72580279440001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470ecada15359baf%3A0x394a3b09fec0c07!2sMl%C3%BDnsk%C3%A1%20350%2F24%2C%20466%2001%20Jablonec%20nad%20Nisou%201!5e0!3m2!1scs!2scz!4v1767351780828!5m2!1scs!2scz" 
                width="100%" 
                height="300" 
                style="border:0; border-radius: 0.5rem;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Scroll reveal
  if (typeof window !== 'undefined') {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.scroll-reveal').forEach(el => {
      observer.observe(el);
    });
  }

  // Contact form handling
  const form = document.getElementById('contactFormElement');
  const formError = document.getElementById('formError');
  const formSuccess = document.getElementById('formSuccess');
  
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]');
      const submitText = submitBtn.querySelector('.submit-text');
      const submitLoader = submitBtn.querySelector('.submit-loader');
      
      // Hide messages
      formError.classList.add('hidden');
      formSuccess.classList.add('hidden');
      
      // Show loading state
      submitBtn.disabled = true;
      submitText.classList.add('hidden');
      submitLoader.classList.remove('hidden');
      
      try {
        const formData = new FormData(form);
        
        // Log for debugging
        console.log('Odeslání formuláře na:', form.action);
        console.log('Data:', {
          name: formData.get('name'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          school: formData.get('school'),
          message: formData.get('message')
        });
        
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });
        
        console.log('Odpověď status:', response.status);
        const responseData = await response.json().catch(() => ({}));
        console.log('Odpověď data:', responseData);
        
        if (response.ok) {
          // Success
          console.log('Formulář úspěšně odeslán');
          formSuccess.classList.remove('hidden');
          form.reset();
          
          // Přesměruj na děkovací stránku
          setTimeout(() => {
            const redirectUrl = responseData.redirect || '/podekovani';
            window.location.href = redirectUrl;
          }, 1500);
        } else {
          throw new Error(responseData.message || `Chyba od serveru: ${response.status}`);
        }
      } catch (error) {
        console.error('Chyba formuláře:', error);
        // Pokud je to chyba sítě
        if (error instanceof TypeError && error.message.includes('fetch')) {
          formError.textContent = '❌ Nelze se připojit k serveru. Zkontrolujte připojení k internetu.';
        } else {
          formError.textContent = '❌ ' + error.message;
        }
        formError.classList.remove('hidden');
        
        // Reset button state
        submitBtn.disabled = false;
        submitText.classList.remove('hidden');
        submitLoader.classList.add('hidden');
      }
    });
  }
</script>

