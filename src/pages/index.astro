  <!-- Přidejte se k našim spokojeným zákazníkům -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-12 scroll-reveal">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">Weby pro školy, kterým ředitelé důvěřují</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Vytváříme weby pro mateřské, základní a střední školy po celé České republice.
        </p>
      </div>
      
      <!-- Statistiky -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 max-w-4xl mx-auto">
        <div class="text-center scroll-reveal bg-white rounded-xl p-8 shadow-sm">
          <div class="text-4xl md:text-5xl font-bold text-brand mb-2"><span class="count" data-target="8" data-duration="2000">0</span> <span class="text-lg font-medium">týdnů</span></div>
          <div class="text-gray-600 font-medium">od prvního kontaktu po spuštění webu školy</div>
        </div>
        <div class="text-center scroll-reveal bg-white rounded-xl p-8 shadow-sm">
          <div class="text-4xl md:text-5xl font-bold text-brand mb-2"><span class="count" data-target="99" data-duration="1200">0</span><span class="text-lg font-medium">%</span></div>
          <div class="text-gray-600 font-medium">dlouhodobě spokojených s řešením Školní weby</div>
        </div>
        <div class="text-center scroll-reveal bg-white rounded-xl p-8 shadow-sm">
          <div class="text-4xl md:text-5xl font-bold text-brand mb-2"><span class="text-lg font-medium">až</span> <span class="count" data-target="12" data-duration="1500">0</span> <span class="text-lg font-medium">měsíců</span></div>
          <div class="text-gray-600 font-medium">v ceně každého balíčku</div>
        </div>
      </div>

      <!-- Typy škol -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-6 scroll-reveal">
        <div class="bg-white px-6 py-3 rounded-lg shadow-sm max-w-xs text-center">
          <div class="text-base font-semibold text-brand">Mateřské školy</div>
        </div>
        <div class="bg-white px-6 py-3 rounded-lg shadow-sm max-w-xs text-center">
          <div class="text-base font-semibold text-brand">Základní školy</div>
        </div>
        <div class="bg-white px-6 py-3 rounded-lg shadow-sm max-w-xs text-center">
          <div class="text-base font-semibold text-brand">Střední školy</div>
        </div>
        <div class="bg-white px-6 py-3 rounded-lg shadow-sm max-w-xs text-center">
          <div class="text-base font-semibold text-brand">Odborné školy</div>
        </div>
      </div>

      <div class="text-center mt-12 scroll-reveal">
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Každý typ školy má jiné potřeby. Proto weby navrhujeme na míru konkrétnímu stupni vzdělávání
        </p>
      </div>

      <script is:inline>
        // Animace čísel - spustí se při načtení
        function initCounters() {
          const easeOutQuad = (t) => t * (2 - t);
          
          const animate = (el, target, duration) => {
            if (!el || el.dataset.animated === 'true') return;
            el.dataset.animated = 'true';
            
            let start = null;
            const initial = 0;
            
            const tick = (ts) => {
              if (!start) start = ts;
              const elapsed = ts - start;
              const progress = Math.min(elapsed / duration, 1);
              const value = Math.round(initial + (target - initial) * easeOutQuad(progress));
              el.textContent = value;
              if (progress < 1) {
                requestAnimationFrame(tick);
              }
            };
            
            requestAnimationFrame(tick);
          };
          
          const counters = document.querySelectorAll('.count');
          counters.forEach((el) => {
            const target = parseInt(el.dataset.target, 10) || 0;
            const duration = parseInt(el.dataset.duration, 10) || 1500;
            animate(el, target, duration);
          });
        }
        
        // Spustit, jakmile je DOM připravený
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initCounters);
        } else {
          initCounters();
        }
        
        // Pro hot reload v development
        window.addEventListener('astro:page-load', initCounters);
      </script>
    </div>
  </section>

  <!-- Proč to školy řeší -->
