---
interface Props {
  title: string;
  type: string;
  city: string;
  image: string;
  url?: string;
}
const { title, type, city, image, url } = Astro.props;

const typeLabels: Record<string, string> = {
  ms: 'MŠ',
  zs: 'ZŠ',
  ss: 'SŠ',
  zus: 'ZUŠ',
};
---

<a href={url || '#'} class="block group" target={url ? '_blank' : undefined} rel={url ? 'noreferrer' : undefined}>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
    <div class="aspect-video bg-gray-100 overflow-hidden img-with-label">
      <img 
        src={image} 
        alt={`${title} - ${city}`}
        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
        loading="lazy"
      />
      {image && image.includes('placeholder') && (
        <span class="img-label">NAHRADIT</span>
      )}
    </div>
    <div class="p-6">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold text-brand uppercase tracking-wide">{typeLabels[type] || type}</span>
        <span class="text-sm text-gray-500 font-medium">{city}</span>
      </div>
      <h3 class="font-bold text-lg text-gray-900">{title}</h3>
    </div>
  </div>
</a>

