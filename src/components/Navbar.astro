---
import { getUrl } from '../lib/utils';
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-transparent backdrop-blur-md transition-all duration-300 border-b border-transparent">
  <div class="container-custom">
    <div class="flex items-center justify-between h-20 md:h-24 gap-6">
      <!-- Logo -->
      <a href={base} class="flex items-center gap-4">
        <img src="https://lukaskoula.com/wp-content/uploads/2025/12/skolni-weby-logo-modra-webp.webp" alt="ŠkolníWeby logo" class="h-10 sm:h-12" />
        <span class="sr-only">ŠkolníWeby</span>
      </a>

      <!-- Center pill navigation (desktop) -->
      <div class="hidden lg:flex items-center mx-auto">
        <nav class="nav-pill flex items-center gap-8 px-6 py-2 rounded-full">
          <a href={getUrl('/ukazky')} class={`text-base md:text-lg font-medium transition-colors ${currentPath === '/ukazky' ? 'text-brand' : 'text-gray-700 hover:text-brand'}`}>
            Ukázky
          </a>
          <a href={getUrl('/cenik')} class={`text-base md:text-lg font-medium transition-colors ${currentPath === '/cenik' ? 'text-brand' : 'text-gray-700 hover:text-brand'}`}>
            Ceník
          </a>
          <a href={getUrl('/blog')} class={`text-base md:text-lg font-medium transition-colors ${currentPath.startsWith('/blog') ? 'text-brand' : 'text-gray-700 hover:text-brand'}`}>
            Blog
          </a>
          <a href={getUrl('/jak-to-probiha')} class={`text-base md:text-lg font-medium transition-colors ${currentPath === '/jak-to-probiha' ? 'text-brand' : 'text-gray-700 hover:text-brand'}`}>
            Jak to probíhá
          </a>
          <a href={getUrl('/kontakt')} class={`text-base md:text-lg font-medium transition-colors ${currentPath === '/kontakt' ? 'text-brand' : 'text-gray-700 hover:text-brand'}`}>
            Kontakt
          </a>
        </nav>
      </div>

      <!-- Right actions -->
      <div class="flex items-center gap-4">
        <a href={getUrl('/kontakt')} class="px-5 py-3 bg-accent text-white text-base font-medium rounded-lg hover:bg-brand transition-colors">
          Nezávazná nabídka
        </a>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-button" class="lg:hidden p-2 text-gray-700 hover:text-brand transition-colors" aria-label="Otevřít menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden pb-4 border-t border-transparent mt-2">
      <div class="flex flex-col gap-4 pt-4">
        <a href={getUrl('/ukazky')} class={`text-base font-medium transition-colors ${currentPath === '/ukazky' ? 'text-brand' : 'text-gray-700'}`}>
          Ukázky
        </a>
        <a href={getUrl('/cenik')} class={`text-base font-medium transition-colors ${currentPath === '/cenik' ? 'text-brand' : 'text-gray-700'}`}>
          Ceník
        </a>
        <a href={getUrl('/blog')} class={`text-base font-medium transition-colors ${currentPath.startsWith('/blog') ? 'text-brand' : 'text-gray-700'}`}>
          Blog
        </a>
        <a href={getUrl('/jak-to-probiha')} class={`text-base font-medium transition-colors ${currentPath === '/jak-to-probiha' ? 'text-brand' : 'text-gray-700'}`}>
          Jak to probíhá
        </a>
        <a href={getUrl('/kontakt')} class={`text-base font-medium transition-colors ${currentPath === '/kontakt' ? 'text-brand' : 'text-gray-700'}`}>
          Kontakt
        </a>
        <a href={getUrl('/kontakt')} class="px-4 py-2 bg-accent text-white text-base font-medium rounded-lg hover:bg-brand transition-colors text-center">
          Nezávazná nabídka
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  if (typeof window !== 'undefined') {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    
    if (button && menu) {
      button.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }
  }
</script>

<style>
  nav.scrolled {
    @apply bg-white/95 backdrop-blur-md shadow-sm border-b border-gray-100;
  }
</style>

