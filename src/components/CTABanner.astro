---
interface Props {
  title: string;
  ctaText: string;
  ctaHref?: string;
}
const { title, ctaText, ctaHref = '/kontakt' } = Astro.props;
---

<section class="bg-brand text-white">
  <div class="container-custom py-16 md:py-20">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-6 text-balance">
        {title}
      </h2>
      <a 
        href={ctaHref}
        class="inline-block px-8 py-4 bg-accent text-white font-semibold rounded-lg hover:bg-brand transition-all transform hover:scale-105"
      >
        {ctaText}
      </a>
    </div>
  </div>
</section>

