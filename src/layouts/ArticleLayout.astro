---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  cover?: string;
  coverAlt?: string;
  date?: string;
  author?: string;
  readingTime?: string;
  tags?: string[];
  faq?: Array<{ question: string; answer: string }>;
  cta?: { text: string; href: string };
}

const {
  title,
  description = '',
  cover = '/images/og-image.webp',
  coverAlt = title || 'Cover image',
  date = '',
  author = 'Redakce',
  readingTime = '',
  tags = [],
  faq = [],
  cta = { text: 'Nezávazná konzultace', href: '/kontakt' },
} = Astro.props as Props;

const site = Astro.site || 'https://skolniweby.cz';
const canonical = new URL(Astro.url.pathname, site).toString();

// Structured data (Article / BlogPosting)
const jsonLd: any = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  },
  "headline": title,
  "description": description,
  "image": [new URL(cover.replace(/^\//, ''), site).toString()],
  "author": {
    "@type": "Organization",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "ŠkolníWeby",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('images/og-image.webp', site).toString()
    }
  },
  "datePublished": date || undefined
};

if (faq && faq.length) {
  jsonLd.suggestedAnswer = undefined;
}
---

<BaseLayout title={title} description={description} ogImage={cover}>
  <article class="section bg-white">
    <div class="container-custom max-w-4xl">
      <!-- Hero -->
      <header class="mb-8">
        <figure class="mb-6">
          <img src={cover} alt={coverAlt} loading="lazy" decoding="async" class="w-full h-64 object-cover rounded-lg shadow-sm" />
        </figure>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-gray-900 mb-3">{title}</h1>

        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-4">
          <div class="flex items-center gap-3">
            <div class="font-medium text-gray-900">{author}</div>
          </div>
          <span aria-hidden class="text-gray-300">•</span>
          {date && (<time datetime={date}>{date}</time>)}
          {readingTime && (
            <>
              <span aria-hidden class="text-gray-300">•</span>
              <span>{readingTime}</span>
            </>
          )}
        </div>

        <div class="flex gap-2 mb-6">
          {tags.map(tag => (
            <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">{tag}</span>
          ))}
        </div>

        {description && <p class="text-lg text-gray-600">{description}</p>}
      </header>

      <div class="lg:grid lg:grid-cols-4 lg:gap-8">
        <!-- Main content (col-span-3) -->
        <div class="lg:col-span-3">
          <slot />

          <!-- Mid-article CTA (approx. 50% mark can be placed by editor) -->
          <div class="my-8 p-6 bg-accent/5 border border-accent/10 rounded-lg">
            <div class="max-w-prose">
              <p class="font-semibold text-gray-900 mb-2">Řešíte web školy a nevíte, kde začít?</p>
              <p class="text-gray-700 mb-4">Nabízíme konzultaci a návrh řešení šité na míru vaší škole.</p>
              <a href={cta.href} class="inline-block px-4 py-2 bg-accent text-white rounded-md hover:bg-brand">{cta.text}</a>
            </div>
          </div>

          <!-- Related & CTA at end -->
          <div class="mt-12">
            <div class="mb-6">
              <h3 class="text-lg font-semibold">Související články</h3>
              <ul class="mt-3 space-y-2 text-gray-700">
                <li><a href="/clanky" class="hover:underline">Jak vytvořit přehledný školní web: rychlý přehled</a></li>
                <li><a href="/clanky" class="hover:underline">Přístupnost školního webu: základy</a></li>
                <li><a href="/clanky" class="hover:underline">Co musí obsahovat školní web v roce 2025</a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- TOC / Sticky aside (col-span-1) -->
        <aside class="hidden lg:block lg:col-span-1">
          <nav aria-label="Obsah článku" class="sticky top-28">
            <div id="article-toc" class="text-sm text-gray-700 bg-white/60 p-4 rounded-md border border-gray-100 shadow-sm">
              <div class="font-semibold mb-2">Obsah</div>
              <div id="toc-list" />
            </div>
          </nav>
        </aside>
      </div>

      <!-- FAQ structured data (render as visible FAQ if provided) -->
      {faq && faq.length > 0 && (
        <section class="mt-12" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="text-2xl font-bold mb-4">Často kladené otázky</h2>
          <div class="space-y-4">
            {faq.map(item => (
              <div>
                <h3 class="font-semibold">{item.question}</h3>
                <p class="text-gray-700">{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- JSON-LD for Article and optional FAQ -->
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

      <script>
        {`(function(){
          // Client-side TOC builder: collects H2 headings inside article content
          function buildTOC(){
            var container = document.getElementById('toc-list');
            if(!container) return;
            var article = document.querySelector('article');
            if(!article) return;
            var headings = article.querySelectorAll('h2');
            if(!headings.length){ container.innerHTML = '<div class="text-sm text-gray-500">Žádné sekce</div>'; return; }
            var ul = document.createElement('ul'); ul.className = 'space-y-2';
            headings.forEach(function(h){
              if(!h.id){ h.id = h.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g,'-'); }
              var li = document.createElement('li');
              var a = document.createElement('a'); a.href = '#'+h.id; a.textContent = h.textContent; a.className = 'hover:underline text-sm text-gray-700';
              li.appendChild(a); ul.appendChild(li);
            });
            container.appendChild(ul);
          }
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildTOC); else buildTOC();
        })();`}
      </script>
    </div>
  </article>
</BaseLayout>
