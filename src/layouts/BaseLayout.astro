---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/images/og-image.webp' } = Astro.props;
const base = import.meta.env.BASE_URL;
// Pro GitHub Pages použijeme GitHub Pages URL pokud není site nastaveno
const siteURL = Astro.site || 'https://sonyx9.github.io';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}${ogImage.replace(/^\//, '')}`, siteURL)} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(`${base}${ogImage.replace(/^\//, '')}`, siteURL)} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ŠkolníWeby",
      "url": siteURL,
      "logo": "https://lukaskoula.com/wp-content/uploads/2025/12/skolni-weby-logo-modra-webp.webp",
      "description": "Tvorba moderních webů pro školy - MŠ, ZŠ i SŠ",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "info@broken-mouse.cz",
        "telephone": "+420776831780"
      }
    })} />
    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      .skip-link:focus {
        position: static;
        left: auto;
        width: auto;
        height: auto;
        padding: 0.5rem 1rem;
        background: white;
        border-radius: 0.25rem;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        z-index: 60;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Přeskočit na obsah</a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      // Sticky navbar with blur effect
      if (typeof window !== 'undefined') {
        const navbar = document.querySelector('nav');
        if (navbar) {
          let lastScroll = 0;
          window.addEventListener('scroll', () => {
            const currentScroll = window.pageYOffset;
            if (currentScroll > 50) {
              navbar.classList.add('scrolled');
            } else {
              navbar.classList.remove('scrolled');
            }
            lastScroll = currentScroll;
          });
        }
      }
    </script>
  </body>
</html>

